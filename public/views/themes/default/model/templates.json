        "detail": "themes/<主题>/model/overwrite/detail/<模板key>.blade.php",
        "form": "themes/<主题>/model/overwrite/form/<模板key>.blade.php",
        "home_section": "themes/<主题>/index/templates/<模板key>.blade.php",
        "builtin_fallback": "public/views/model/{list|detail|form}/<模板key>.blade.php（系统内置，随 CMS 升级，主题不要直接改；要改请放到上面 overwrite 目录）"
